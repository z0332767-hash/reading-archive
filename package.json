{
  "name": "reading-archive",
  "version": "0.7.1",
  "description": "A personal reading archive for highlights and ideas",
  "author": "Reading Archive",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check server.mjs && node --check core.mjs && node --check search.mjs && node --check map.mjs && node --check openai-provider.mjs && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.readingarchive.desktop",
    "productName": "Reading Archive",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "index.html",
      "styles.css",
      "app.js",
      "data.js",
      "core.mjs",
      "search.mjs",
      "map.mjs",
      "server.mjs",
      "weread.mjs",
      "openai-provider.mjs",
      "sample-import.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Reading-Archive-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
